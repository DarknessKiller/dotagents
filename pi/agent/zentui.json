{
  "components": {
    "editor": {
      "enabled": true,
      "style": "minimalist",
      "codexQuota": false,
      "colorSource": "terminal",
      "borderColorMode": "static",
      "modelLabel": "name",
      "viewportIndicators": true,
      "styles": {
        "opencode": {
          "metadataFormat": "$model  $provider(  $thinking)(  $fast_mode)(  $codex_quota)",
          "completionMenu": "palette"
        },
        "opencode-copy-friendly": {
          "metadataFormat": "$model  $provider(  $thinking)(  $fast_mode)(  $codex_quota)",
          "completionMenu": "palette"
        },
        "accent-rail": {
          "rail": "▎",
          "asciiRail": "|",
          "transparent": false
        },
        "minimalist": {
          "formats": {
            "bottomLeft": "$session_name$join_sep($git_branch)"
          },
          "pathDisplay": "full",
          "contextFormat": "percent-total",
          "contextGauge": false,
          "showSessionName": false,
          "showTimer": true,
          "showCost": false,
          "showCacheHit": true,
          "showGit": false,
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "separator": "dash",
          "extensionColorMode": "zentui"
        }
      },
      "rail": "|",
      "asciiRail": "|"
    },
    "footer": {
      "style": "starship",
      "codexQuota": false,
      "colorSource": "terminal",
      "modelLabel": "name",
      "styles": {
        "starship": {
          "format": "",
          "responsive": true,
          "compactFormat": "$cwd$wrap(in $session_name)$wrap(on $git_branch) $git_status$wrap$context$wrap_sep$tokens$wrap_sep($codex_quota)",
          "compactMaxLines": 2,
          "separator": "pipe",
          "contextStyle": "text",
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "pathDisplay": {
            "mode": "full",
            "depth": 0
          },
          "segments": {
            "cwd": false,
            "sessionName": false,
            "gitBranch": false,
            "gitStatus": true,
            "gitCounts": false,
            "gitCommit": false,
            "gitMetrics": false,
            "runtime": false,
            "modelInfo": false,
            "context": false,
            "tokens": true,
            "cost": false,
            "sessionDuration": true,
            "username": false,
            "time": false,
            "os": false,
            "packageVersion": false
          },
          "gitBranch": {
            "maxLength": "full"
          },
          "gitCommit": {
            "hashLength": 7,
            "onlyDetached": true,
            "showTag": true
          },
          "gitMetrics": {
            "onlyNonzero": true,
            "ignoreSubmodules": false
          },
          "extensionStatuses": {
            "defaultPlacement": "right",
            "placements": {
              "ponytail": "left",
              "mcp": "left"
            },
            "colorModes": {
              "pi-cache-stats": "zentui",
              "ponytail": "zentui"
            }
          }
        }
      }
    },
    "userMessages": {
      "enabled": true,
      "style": "framed-copy-friendly",
      "colorSource": "terminal",
      "styles": {
        "framed": {},
        "framed-copy-friendly": {},
        "compact": {},
        "labeled": {}
      }
    },
    "toolDisplay": {
      "enabled": true,
      "style": "opencode",
      "registerToolOverrides": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "grep": true,
        "find": true,
        "ls": true
      },
      "builtinRendererOverrides": {},
      "customToolOverrides": {},
      "readOutputMode": "hidden",
      "searchOutputMode": "hidden",
      "mcpOutputMode": "hidden",
      "bashOutputMode": "opencode",
      "bashSyntax": "semantic",
      "previewLines": 8,
      "expandedPreviewMaxLines": 4000,
      "bashCollapsedLines": 10,
      "diffViewMode": "split",
      "diffIndicatorMode": "bars",
      "diffSplitMinWidth": 120,
      "diffCollapsedLines": 24,
      "diffWordWrap": true,
      "showTruncationHints": false,
      "compatibleToolSources": {}
    },
    "selectorBorders": {
      "enabled": true,
      "style": "zentui",
      "colorSource": "terminal"
    },
    "thinkingSteps": {
      "enabled": true,
      "mode": "tree"
    },
    "workingLine": {
      "enabled": true,
      "turnSummary": true,
      "turnSummaryFormat": "Turn took $turn_duration$join_sep(thought for $thought_duration)$join_sep(↑$input_tokens ↓$output_tokens)$join_sep$token_rate",
      "spinner": "claude-inspired",
      "spinnerIntervalMs": 100,
      "animateSpinnerColor": true,
      "textIntervalMs": 60,
      "textAnimation": "kitt",
      "placement": "above",
      "colorSource": "terminal",
      "messages": {
        "custom": true,
        "values": [
          "Sautéing…",
          "Cooking…",
          "Ionizing…",
          "Zigzagging…",
          "Razzle-dazzling…",
          "Photosynthesizing…",
          "Nucleating…",
          "Brewing…",
          "Combobulating…",
          "Boogieing…",
          "Befuddling…",
          "Alchemizing…",
          "Conjuring…",
          "Baking…",
          "Simmering…",
          "Blanching…"
        ]
      },
      "segments": {
        "tokenRate": true,
        "tool": true,
        "elapsed": true,
        "thought": true,
        "tokens": true
      }
    },
    "extensionStatuses": {
      "visibility": {
        "pi-cache-stats": "hide",
        "ponytail": "show",
        "tps": "hide",
        "mcp": "show",
        "subagents": "hide"
      },
      "defaultVisibility": "hide"
    }
  },
  "icons": {
    "mode": "auto"
  }
}
