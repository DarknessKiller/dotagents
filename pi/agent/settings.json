{
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:@dietrichgebert/ponytail",
    "git:github.com/DarknessKiller/pi-cliproxyapi-provider",
    "npm:@quintinshaw/pi-dynamic-workflows",
    "npm:pi-cache-optimizer",
    "git:github.com/DarknessKiller/pi-omniroute-sync",
    "npm:hashline-pi",
    "npm:pi-zentui",
