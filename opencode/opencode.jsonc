{
  "$schema": "https://opencode.ai/config.json",
  "model": "cliproxyapi/mimo-v2.5",
  "plugin": [
    "@dietrichgebert/ponytail",
    [
      "opencode-cliproxyapi",
      {
        "baseURL": "http://localhost:8317",
        "apiKey": "{env:CLIPROXYAPI_API_KEY}"
      }
    ]
  ],
  "permission": "allow",
  "disabled_providers": [
    "opencode",
    "anthropic"
  ]
}
