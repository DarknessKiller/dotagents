{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@dietrichgebert/ponytail",
    "./my-plugins/opencode-hashline",
    {
      "package": "./my-plugins/opencode-cliproxyapi",
      "options": {
        "baseURL": "{env:CLIPROXYAPI_BASE_URL}",
        "apiKey": "{env:CLIPROXYAPI_API_KEY}"
      }
    },
    {
      "package": "./my-plugins/opencode-omniroute-auth",
      "options": {
        "baseURL": "{env:OMNIROUTE_BASE_URL}",
        "apiMode": "chat",
        "refreshOnList": true,
        "modelCacheTtl": 300000
      }
    }
  ]
}
